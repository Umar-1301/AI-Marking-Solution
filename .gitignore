# Superpowers brainstorming companion — local mockup/session scratch, never committed
.superpowers/

# Local Claude Code project instructions — not committed
CLAUDE.md

# Dependencies
**/node_modules/
# workers/node_modules is a symlink to workers/package/node_modules (see
# workers/package/ layout) — the trailing-slash pattern above only matches
# real directories, not symlinks, so it needs its own explicit entry.
workers/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-store/

# Environment files — never commit (secrets AND example templates)
**/.env
**/.env.*
**/local.env
**/local.env.*

# User credentials store — contains hashed passwords
backend/src/data/users.json

# Pepper secret — must never be committed
backend/src/data/pepper.json

# SQLite database and its WAL/SHM companions — local data, never committed
backend/src/data/*.sqlite
backend/src/data/*.sqlite-journal
backend/src/data/*.sqlite-wal
backend/src/data/*.sqlite-shm

# Terraform infra lives in its own folder and is not versioned in this repo.
infra/

# Private keys, certificates and Terraform working data — state files can embed secrets.
*.pem
*.key
*.pfx
*.p12
**/.terraform/
*.tfstate
*.tfstate.*

# Any SQLite store, wherever it lives (RAG exemplars, local test data)
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# SQL Server data files and backups. The evaluation database stores verbatim
# student essays and model output, so a copied volume or .bak is student data.
*.bak
*.mdf
*.ldf
*.ndf

# Local database migration scripts run manually against existing databases
backend/db/migrations/

# AI evaluation suite — imported datasets and result exports contain real
# student work. Only source code and schema belong in version control.
ai-service/evaluation/exports/
ai-service/evaluation/data/

# Load-test harness, results and private account fixtures — local only, never published
load-tests/

# Python — virtualenvs, bytecode, and tool caches
**/venv/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Frontend build output
frontend/dist/
frontend/dist-ssr/

# IDE settings (local to each developer)
.vscode/

# Security documentation (describes controls and attack surface — keep off VCS)
Security-Assessment.md

# Logs — keep directory structure via .gitkeep, ignore all content
*.log
npm-debug.log*
backend/logs/*
!backend/logs/.gitkeep
workers/logs/*
!workers/logs/.gitkeep

# Ad-hoc debug output — temporary inspection only, never committed.
backend/.tmp/
# Descriptor validation comparison dumps. Contains verbatim mark-scheme
# descriptor text (exam board material) and grows per band, per extraction.
ai-service/observability/descriptor_validation_debug.txt

# OS
**/.DS_Store
Thumbs.db
